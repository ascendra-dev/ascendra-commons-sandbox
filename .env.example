# Copy to .env — local dev only.
PORT=3010
DATABASE_URL=postgresql://sandbox:sandbox@localhost:5433/ascendra_commons_sandbox
# The application id stamped on every audit record.
APPLICATION=ascendra-commons-sandbox
# Signs the dev sign-in tokens (POST /dev/token). Any long random string; dev only.
DEV_AUTH_SECRET=sandbox-dev-secret-change-me-0123456789abcdef
# Browser origins allowed to call the API — the ascendra-commons-ui testbed and the ascendra-ui showcase.
CORS_ORIGINS=http://localhost:3002,http://localhost:3000
