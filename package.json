{
  "name": "ascendra-commons-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS host that runs ascendra-commons modules for real, so ascendra-commons-ui is built against real APIs and data.",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main",
    "start:dev": "node --env-file=.env node_modules/.bin/nest start --watch",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env scripts/db-migrate.js",
    "db:reset": "node --env-file=.env scripts/db-reset.js",
    "commons:update": "node scripts/commons-update.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-express": "^10.4.22",
    "drizzle-orm": "^0.44.7",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
