{
  "name": "ascendra-commons-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS host that runs ascendra-commons modules for real, so ascendra-commons-ui is built against real APIs and data.",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main",
    "start:dev": "node --env-file=.env node_modules/.bin/nest start --watch",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env node_modules/.bin/drizzle-kit migrate",
    "db:reset": "node --env-file=.env scripts/db-reset.js",
    "seed": "nest build >/dev/null && node --env-file=.env dist/cli/seed.js",
    "simulate": "nest build >/dev/null && node --env-file=.env dist/cli/simulate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.7",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
